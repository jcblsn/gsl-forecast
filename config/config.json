{
  "sources": {
    "usgs_water_surface_elevation_continuous": {
      "url": "https://waterservices.usgs.gov/nwis/iv/?sites={site}&agencyCd=USGS&parameterCd=62614&format=rdb&startDT={start}&endDT={end}",
      "site_id": "10010100",
      "parameter_code": "62614"
    },
    "usgs_water_surface_elevation_daily": {
      "url": "https://waterservices.usgs.gov/nwis/dv?format=json&siteStatus=all&site={site}&agencyCd=USGS&statCd=00003&parameterCd=62614&startDT={start}&endDT={end}",
      "site_id": "10010000"
    }
  },
  "database": {
    "path": "./data/gsl.db"
  },
  "forecasting": {
    "train_start": "1960-01-01",
    "horizon": 24,
    "experiment_db": "forecast_experiments.db",
    "output_dir": "./outputs",
    "cv": {
      "history_years": 15,
      "cutoffs": "all"
    }
  },
  "covariates": {
    "snotel": {
      "states": [
        "UT",
        "WY",
        "ID"
      ],
      "basins": {
        "1601": "bear",
        "160201": "weber",
        "160202": "provo_jordan"
      },
      "start": "1978-10-01"
    },
    "usgs_discharge": {
      "sites": {
        "bear": "10127110",
        "weber": "10141000",
        "jordan": "10170490"
      },
      "start": "1900-01-01"
    }
  }
}
